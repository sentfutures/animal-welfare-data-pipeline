.env
__pycache__/
*.pyc
*.pyo
.DS_Store
*.egg-info/
.venv/

# Local ad-hoc / test runs — viewable in the run viewer, never published.
# The `local_` label appears in two positions: leading (local_<date>_...) and,
# since run dirs gained a timestamp prefix, mid-name (<date>_<time>_local_...).
outputs/*/runs/local_*/
outputs/*/runs/*_local_*/

# The `latest` symlinks are machine-local pointers that churn on every run and
# dangle for anyone who prunes runs — regenerated by the pipeline, not tracked.
outputs/*/latest

# Per-run embedding caches (evals/diversity.py) — megabytes of float32 vectors,
# regenerated for cents; the diversity_report.json next to them stays tracked.
# Bare filename so it matches wherever --input puts the audit/ dir (run dirs
# under outputs/, but also next to a bare --input corpus.jsonl anywhere).
embeddings_cache.npz

# Machine-local config override (backend: auto etc.) — never committed
config.local.yaml

# A `--site-url` build copies the card image out beside the page, but the deploy
# stages it from website/assets/ (see .github/workflows/pages.yml), so this copy
# is a build artefact and would be a second, drifting 60KB binary in git.
# The committed card image is website/assets/preview.png.
/website/preview.png

# Log-probability persona check (evals/log_probability_persona_check): per-token score files are large and are
# regenerated by the scorer, and a pod's log copies are machine-specific. These match wherever audit run folders land
# (inside a pipeline run's audit/ directory or beside a bare corpus file). The run configuration, summary tables,
# extreme-span files and analysis notes are not matched and stay trackable.
per_token_log_probabilities/
*.partial
pod_*_logs_*/
pod_progress_log_*.txt
