# Copy this file to .env and fill in your key:
#   cp .env.example .env
# Your Anthropic API key (required for backend: api, the default)
ANTHROPIC_API_KEY=
# Optional: only for the claude_code dev backend (see CLAUDE.md). Not needed
# for backend: api, and not needed at all if Claude Code is already logged in.
# Read from this file only (or the environment with --find-dotenv), like the other keys.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: only evals/diversity.py (embedding-based diversity audit) reads this
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: only evals/publish_hf.py (Hugging Face dataset publishing) reads this.
# Needs write access to the target repo/org. Not needed if you've already run
# `huggingface-cli login` on this machine — huggingface_hub checks this env var
# first, then falls back to that cached login.
HF_TOKEN=

